---
import type { CaseStudy } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { item: CaseStudy; href?: string; large?: boolean }
const { item, href, large = false } = Astro.props;
---
<article class={`case card ${large ? 'is-large' : ''}`} style={`--c:${item.color}`}>
  <div class="case-logo">
    {item.logo && !item.mark && <img src={item.logo} alt={`${item.client} logo`} class="wordmark" loading="lazy" />}
    {item.logo && item.mark && (
      <span class="mark-row">
        <img src={item.logo} alt="" class="mark" loading="lazy" />
        <span class="name">{item.client}</span>
      </span>
    )}
    {!item.logo && <span class="name">{item.client}</span>}
  </div>
  <div class="case-body">
    <h3 class="h3">{item.title}</h3>
    <p>{item.result}</p>
    {href && <a href={href} class="link">Read Detailed Case Study <Arrow /></a>}
  </div>
</article>

<style>
  .case { padding: 0; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s; }
  .case:hover { transform: translateY(-3px); box-shadow: 0 2px 4px rgba(15, 27, 45, 0.04), 0 20px 40px -20px rgba(15, 27, 45, 0.25); }
  .case-logo {
    position: relative;
    height: 150px;
    display: grid; place-items: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 7%, #fff), #fff);
    border-bottom: 1px solid var(--line);
  }
  .case-logo::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--c); }
  .is-large .case-logo { height: 200px; }
  .wordmark { height: 38px; width: auto; max-width: 60%; }
  .is-large .wordmark { height: 50px; }
  .mark-row { display: inline-flex; align-items: center; gap: 12px; }
  .mark { width: 40px; height: 40px; }
  .name { font-size: 26px; font-weight: 680; letter-spacing: -0.025em; color: var(--c); }
  .is-large .name { font-size: 32px; }
  .case-body { padding: 24px 26px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .case-body p { color: var(--muted); font-size: 16px; }
  .case-body .link { margin-top: auto; padding-top: 8px; }
</style>
