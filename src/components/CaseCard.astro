---
import type { CaseStudy } from '../data/site';
interface Props { item: CaseStudy; index: number; class?: string }
const { item, index, class: cls = '' } = Astro.props;
const n = String(index + 1).padStart(2, '0');
---
<article class={`case ${cls}`} style={`--h:${item.hue}`} data-tilt>
  <div class="case-cover">
    <svg class="case-art" viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id={`g${index}-${item.hue}`} cx="70%" cy="20%" r="90%">
          <stop offset="0" stop-color={`hsl(${item.hue} 90% 62%)`} />
          <stop offset=".55" stop-color={`hsl(${item.hue} 60% 22%)`} />
          <stop offset="1" stop-color="#0a0b0d" />
        </radialGradient>
      </defs>
      <rect width="400" height="260" fill={`url(#g${index}-${item.hue})`} />
      {Array.from({ length: 14 }).map((_, i) => (
        <line x1={200} y1={-40} x2={-260 + i * 66} y2={300} stroke="rgba(255,255,255,.14)" stroke-width="1" />
      ))}
      {Array.from({ length: 6 }).map((_, i) => (
        <line x1="0" x2="400" y1={130 + i * i * 6} y2={130 + i * i * 6} stroke="rgba(255,255,255,.1)" />
      ))}
    </svg>
    <span class="case-n">{n}</span>
    <span class="case-tag">{item.tag}</span>
    <span class="case-client display">{item.client}</span>
  </div>
  <div class="case-body">
    <h3>{item.client} – {item.title}</h3>
    <p>{item.result}</p>
  </div>
</article>

<style>
  .case {
    display: flex; flex-direction: column;
    border-radius: 24px;
    background: var(--ink-3);
    border: 1px solid var(--line-dark);
    overflow: hidden;
    transform-style: preserve-3d;
    transition: border-color 0.4s;
  }
  .case:hover { border-color: hsl(var(--h) 80% 60% / 0.5); }
  .case-cover { position: relative; aspect-ratio: 16 / 10.4; overflow: hidden; }
  .case-art { width: 100%; height: 100%; transition: transform 1.2s var(--ease); }
  .case:hover .case-art { transform: scale(1.08); }
  .case-n, .case-tag {
    position: absolute; top: 16px;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 6px 10px; border-radius: 999px;
    background: rgba(10, 11, 13, 0.5); backdrop-filter: blur(6px);
  }
  .case-n { left: 16px; }
  .case-tag { right: 16px; }
  .case-client { position: absolute; left: 20px; bottom: 14px; font-size: clamp(34px, 3.6vw, 52px); color: #fff; }
  .case-body { padding: 22px 22px 26px; display: grid; gap: 10px; }
  .case-body h3 { font-size: 19px; font-weight: 560; letter-spacing: -0.01em; }
  .case-body p { color: var(--muted-dark); font-size: 15px; line-height: 1.5; }
</style>
