---
import type { CaseStudy } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { item: CaseStudy; href?: string; large?: boolean }
const { item, href, large = false } = Astro.props;
---
<article class={`case ${large ? 'is-large' : ''}`}>
  <div class="case-art">
    {item.logo && !item.mark && <img src={item.logo} alt={`${item.client} logo`} class="wordmark" loading="lazy" />}
    {item.logo && item.mark && (
      <span class="mark-row">
        <img src={item.logo} alt="" class="mark" loading="lazy" />
        <span class="name">{item.client}</span>
      </span>
    )}
    {!item.logo && <span class="name">{item.client}</span>}
  </div>
  <div class="case-body">
    <h3 class={large ? 'd-lg' : 'd-md'}>{item.title}</h3>
    <p class="muted">{item.result}</p>
    {href && <a href={href} class="btn btn-outline case-btn">Read Detailed Case Study <Arrow /></a>}
  </div>
</article>

<style>
  .case { display: flex; flex-direction: column; height: 100%; background: var(--color-limestone); border-radius: var(--radius-cards); padding: 16px; }
  .case-art {
    position: relative;
    height: 180px;
    display: grid; place-items: center;
    border-radius: calc(var(--radius-cards) - 12px);
    background-color: var(--color-ember);
    background-image: radial-gradient(circle, rgba(7, 6, 7, 0.16) 1.6px, transparent 1.8px);
    background-size: 11px 11px;
    overflow: hidden;
  }
  .is-large .case-art { height: 260px; }
  .wordmark { height: 40px; width: auto; max-width: 62%; }
  .is-large .wordmark { height: 56px; }
  .mark-row { display: inline-flex; align-items: center; gap: 14px; }
  .mark { width: 44px; height: 44px; }
  .name { font-family: var(--font-display); font-size: 40px; line-height: 1; letter-spacing: 0.02em; color: var(--color-obsidian); text-align: center; padding: 0 16px; }
  .is-large .name { font-size: 52px; }
  .case-body { padding: 24px 16px 16px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; flex: 1; }
  .case-btn { margin-top: auto; }
  .case-body .muted { margin-bottom: 8px; }
</style>
