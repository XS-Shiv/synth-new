---
import Arrow from './Arrow.astro';
import { cta, BOOK_URL } from '../data/site';
---
<section class="section">
  <div class="wrap">
    <div class="card-dark on-dark cta" data-reveal>
      <h2 class="d-3xl">{cta.title}</h2>
      <div class="cta-foot">
        <p class="body-lg">{cta.sub}</p>
        <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call <Arrow /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { display: flex; flex-direction: column; gap: 40px; position: relative; overflow: hidden; }
  .cta::after {
    content: ''; position: absolute; right: -40px; top: -40px; width: 340px; height: 340px;
    background-image: radial-gradient(circle, var(--color-ember) 2.4px, transparent 2.6px);
    background-size: 13px 13px;
    -webkit-mask-image: radial-gradient(circle at 70% 30%, #000 10%, transparent 68%);
    mask-image: radial-gradient(circle at 70% 30%, #000 10%, transparent 68%);
    pointer-events: none;
  }
  .cta h2 { max-width: 14ch; position: relative; }
  .cta-foot { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-top: 24px; border-top: 1.5px dotted rgba(255, 255, 255, 0.5); position: relative; }
</style>
