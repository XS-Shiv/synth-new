---
import Arrow from './Arrow.astro';
import { cta, BOOK_URL } from '../data/site';
---
<section class="section cta-wrap">
  <div class="wrap">
    <div class="cta" data-reveal>
      <div>
        <h2 class="h2">{cta.title}</h2>
        <p class="lead">{cta.sub}</p>
      </div>
      <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .cta-wrap { padding-top: 0; }
  .cta {
    display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap;
    padding: clamp(36px, 5vw, 64px);
    border-radius: 20px;
    background: linear-gradient(120deg, var(--bg-tint), #f8fbff 60%, var(--blue-soft));
    border: 1px solid #d6e2f5;
  }
  .cta .lead { margin-top: 10px; }
</style>
