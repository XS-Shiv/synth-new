---
import Logo from './Logo.astro';
import { solutions, tagline, footerBlurb, copyright, CAREERS_URL, LINKEDIN_URL, BLOGS_URL, PRIVACY_URL } from '../data/site';
---
<footer class="ftr">
  <div class="wrap ftr-top">
    <div class="ftr-brand">
      <Logo />
      <p class="ftr-tag">{tagline}</p>
      <p class="ftr-blurb">{footerBlurb}</p>
    </div>
    <div class="ftr-col">
      <p class="ftr-h">Synthlane</p>
      <a href="/">Home</a>
      <a href="/about-us">About Us</a>
      <a href="/our-portfolio">Our Work</a>
      <a href={PRIVACY_URL}>Privacy Policy</a>
      <a href={BLOGS_URL}>Blogs</a>
      <a href={CAREERS_URL} target="_blank" rel="noopener">Careers</a>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
    </div>
    <div class="ftr-col">
      <p class="ftr-h">Solutions We Provide</p>
      {solutions.map((s) => <a href={`/solutions/${s.slug}`}>{s.nav}</a>)}
    </div>
  </div>
  <div class="wrap ftr-bottom"><p>{copyright}</p></div>
</footer>

<style>
  .ftr { background: var(--bg-soft); border-top: 1px solid var(--line); padding-top: clamp(56px, 7vw, 88px); }
  .ftr-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; padding-bottom: 48px; }
  .ftr-tag { font-size: 22px; font-weight: 600; letter-spacing: -0.015em; margin: 20px 0 8px; color: var(--navy); }
  .ftr-blurb { color: var(--muted); max-width: 42ch; font-size: 16px; }
  .ftr-col { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .ftr-col a { color: var(--muted); width: fit-content; }
  .ftr-col a:hover { color: var(--blue); }
  .ftr-h { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  .ftr-bottom { border-top: 1px solid var(--line); padding-top: 20px; padding-bottom: 24px; font-size: 14px; color: var(--muted); }
  @media (max-width: 820px) { .ftr-top { grid-template-columns: 1fr 1fr; } .ftr-brand { grid-column: 1 / -1; } }
</style>
