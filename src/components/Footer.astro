---
import Logo from './Logo.astro';
import { solutions, tagline, footerBlurb, copyright, CAREERS_URL, LINKEDIN_URL, BLOGS_URL, PRIVACY_URL } from '../data/site';
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-card">
      <div class="ftr-top">
        <div class="ftr-brand">
          <Logo />
          <p class="d-lg ftr-tag">{tagline}</p>
          <p class="muted">{footerBlurb}</p>
        </div>
        <div class="ftr-col">
          <p class="tag">Synthlane</p>
          <a href="/">Home</a>
          <a href="/about-us">About Us</a>
          <a href="/our-portfolio">Our Work</a>
          <a href={PRIVACY_URL}>Privacy Policy</a>
          <a href={BLOGS_URL}>Blogs</a>
          <a href={CAREERS_URL} target="_blank" rel="noopener">Careers</a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <div class="ftr-col">
          <p class="tag">Solutions We Provide</p>
          {solutions.map((s) => <a href={`/solutions/${s.slug}`}>{s.nav}</a>)}
        </div>
      </div>
      <hr class="dotted-x" />
      <p class="meta ftr-copy">{copyright}</p>
    </div>
  </div>
</footer>

<style>
  .ftr { padding: calc(var(--section-gap) / 2) 0 24px; }
  .ftr-card { background: var(--color-limestone); border-radius: var(--radius-cards); padding: clamp(28px, 4vw, 48px); }
  .ftr-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; padding-bottom: 40px; }
  .ftr-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .ftr-tag { max-width: 14ch; margin-top: 8px; }
  .ftr-brand .muted { max-width: 40ch; }
  .ftr-col { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .ftr-col .tag { margin-bottom: 6px; }
  .ftr-col a:hover { color: var(--color-ember); }
  .ftr-copy { padding-top: 20px; }
  @media (max-width: 860px) { .ftr-top { grid-template-columns: 1fr 1fr; } .ftr-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .ftr-top { grid-template-columns: 1fr; } }
</style>
