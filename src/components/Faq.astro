---
import type { Faq } from '../data/site';
interface Props { items: Faq[]; intro?: string }
const { items, intro } = Astro.props;
---
{items.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="panel faq" data-reveal>
        <div class="faq-head">
          <h2 class="d-2xl">Frequently Asked Questions</h2>
          {intro && <p class="body-lg muted">{intro}</p>}
        </div>
        <div class="faq-list">
          {items.map((f, i) => (
            <details class="faq-item">
              <summary>
                <span class="faq-n">{i + 1}.</span>
                <span class="faq-q">{f.q}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <p class="faq-a muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .faq { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .faq-head { display: flex; flex-direction: column; gap: 16px; }
  .faq-item { border-bottom: var(--dotted); }
  .faq-item:first-child { border-top: var(--dotted); }
  summary { list-style: none; display: grid; grid-template-columns: 32px 1fr 36px; align-items: center; gap: 8px; padding: 20px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .faq-n { color: var(--color-ember); }
  .faq-q { font-size: 18px; line-height: 1.35; }
  summary:hover .faq-q { color: var(--color-ember); }
  .faq-icon { position: relative; width: 36px; height: 36px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--color-obsidian); transition: background 0.2s, box-shadow 0.2s; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 11px; right: 11px; top: 17px; height: 1.6px; background: var(--color-obsidian); transition: transform 0.25s; }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon { background: var(--color-ember); box-shadow: none; }
  details[open] .faq-icon::after { transform: rotate(0); }
  .faq-a { padding: 0 44px 22px 40px; max-width: 64ch; }
  @media (max-width: 900px) { .faq { grid-template-columns: 1fr; } .faq-a { padding-right: 0; } }
</style>
