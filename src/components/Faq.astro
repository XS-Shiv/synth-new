---
import type { Faq } from '../data/site';
interface Props { items: Faq[]; intro?: string }
const { items, intro } = Astro.props;
---
{items.length > 0 && (
  <section class="section faq">
    <div class="wrap faq-grid">
      <div class="faq-head" data-reveal>
        <h2 class="h2">Frequently Asked Questions</h2>
        {intro && <p class="lead">{intro}</p>}
      </div>
      <div class="faq-list" data-reveal>
        {items.map((f, i) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q">{i + 1}. {f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  .faq-head .lead { margin-top: 14px; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-size: 18px; font-weight: 560; }
  summary:hover .faq-q { color: var(--blue); }
  .faq-icon { position: relative; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--bg-tint); }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 8px; right: 8px; top: 13.2px; height: 1.6px; background: var(--navy); transition: transform 0.25s; }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon::after { transform: rotate(0); }
  .faq-a { padding: 0 48px 22px 0; color: var(--muted); }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
