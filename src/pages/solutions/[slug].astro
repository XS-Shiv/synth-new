---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CaseCard from '../../components/CaseCard.astro';
import Faq from '../../components/Faq.astro';
import { solutions, caseStudies, casesSection, techStack, type Solution } from '../../data/site';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Solution };
const cols = s.services.length === 4 ? 'grid-2' : 'grid-3';
---
<Base title={`${s.title} | Synthlane`} description={s.intro}>
  <PageHero title={s.title} intro={s.intro} cta="Book a Free Consultation" crumbs={[{ label: 'Solutions' }, { label: s.title }]} />

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="d-2xl">{s.coreTitle}</h2>
        <p class="body-lg muted">{s.coreSub}</p>
      </div>
      <div class={cols}>
        {s.services.map((it, i) => (
          <article class="card svc" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="tag">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="d-md">{it.title}</h3>
            <p class="muted">{it.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap why">
      <div class="card-ember why-intro" data-reveal>
        <h2 class="d-2xl">{s.whyTitle}</h2>
        <p class="body-lg">{s.whySub}</p>
      </div>
      <ul class="why-list">
        {s.why.map((w, i) => (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="tick" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg></span>
            <div>
              <h3 class="d-sm">{w.title}</h3>
              <p class="muted">{w.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <h2 class="d-2xl">{casesSection.title}</h2>
        <p class="body-lg muted">{casesSection.sub}</p>
      </div>
      <div class="grid-3">
        {caseStudies.map((c, i) => (
          <div data-reveal style={`transition-delay:${(i % 3) * 70}ms`}><CaseCard item={c} href="/our-portfolio" /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="panel stack" data-reveal>
        <div class="stack-head">
          <h2 class="d-lg">Our Tech stack</h2>
          <p class="muted">{s.stackSub}</p>
        </div>
        <ul class="stack-row">
          {techStack.map((t) => (
            <li><img src={t.logo} alt="" loading="lazy" /><span>{t.name}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="d-2xl">{s.processTitle}</h2>
        {s.processSub && <p class="body-lg muted">{s.processSub}</p>}
      </div>
      <ol class="grid-4 proc">
        {s.process.map((p, i) => (
          <li class="card proc-step" data-reveal style={`transition-delay:${i * 70}ms`}>
            <span class="proc-n">{i + 1}</span>
            <h3 class="d-sm">{p.title}</h3>
            <p class="muted">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq items={s.faqs} />
</Base>

<style>
  .svc { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-height: 260px; }
  .svc .tag { margin-bottom: auto; }

  .why { display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--element-gap); align-items: stretch; }
  .why-intro { color: var(--color-obsidian); display: flex; flex-direction: column; justify-content: flex-end; gap: 16px; min-height: 380px; }
  .why-list { list-style: none; margin: 0; padding: clamp(24px, 3.2vw, 40px); background: var(--color-limestone); border-radius: var(--radius-cards); display: flex; flex-direction: column; }
  .why-list li { display: flex; gap: 16px; align-items: flex-start; padding: 20px 0; border-bottom: var(--dotted); }
  .why-list li:first-child { padding-top: 0; }
  .why-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .why-list p { margin-top: 6px; }
  .tick { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--color-ember); display: grid; place-items: center; }
  .tick svg { width: 15px; height: 15px; fill: none; stroke: var(--color-obsidian); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .stack { display: flex; flex-direction: column; gap: 32px; }
  .stack-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 40px; flex-wrap: wrap; }
  .stack-head .muted { max-width: 46ch; }
  .stack-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); }
  .stack-row li { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 12px 8px; border-left: var(--dotted); }
  .stack-row li:first-child { border-left: 0; }
  .stack-row img { height: 40px; width: auto; max-width: 90px; }
  .stack-row span { font-size: 14px; }

  .proc { list-style: none; margin: 0; padding: 0; }
  .proc-step { display: flex; flex-direction: column; gap: 12px; min-height: 260px; }
  .proc-n { width: 56px; height: 56px; border-radius: 50%; background: var(--color-ember); display: grid; place-items: center; font-family: var(--font-display); font-size: 26px; margin-bottom: auto; }

  @media (max-width: 900px) {
    .why { grid-template-columns: 1fr; }
    .why-intro { min-height: 0; }
    .stack-row { grid-template-columns: repeat(3, 1fr); row-gap: 16px; }
    .stack-row li:nth-child(4) { border-left: 0; }
  }
</style>
