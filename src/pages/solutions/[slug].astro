---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CaseCard from '../../components/CaseCard.astro';
import Faq from '../../components/Faq.astro';
import { solutions, caseStudies, casesSection, techStack, type Solution } from '../../data/site';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Solution };
---
<Base title={`${s.title} | Synthlane`} description={s.intro}>
  <PageHero title={s.title} intro={s.intro} cta="Book a Free Consultation" crumbs={[{ label: 'Solutions' }, { label: s.title }]} />

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2">{s.coreTitle}</h2>
        <p class="lead">{s.coreSub}</p>
      </div>
      <div class={s.services.length % 3 === 0 || s.services.length === 5 ? 'grid-3' : 'grid-2'}>
        {s.services.map((it, i) => (
          <article class="card svc" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{it.title}</h3>
            <p>{it.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap why">
      <div data-reveal>
        <h2 class="h2">{s.whyTitle}</h2>
        <p class="lead why-sub">{s.whySub}</p>
      </div>
      <ul class="why-list">
        {s.why.map((w, i) => (
          <li class="card" data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="tick" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg></span>
            <div>
              <h3 class="h3">{w.title}</h3>
              <p>{w.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2">{casesSection.title}</h2>
        <p class="lead">{casesSection.sub}</p>
      </div>
      <div class="grid-3">
        {caseStudies.map((c, i) => (
          <div data-reveal style={`transition-delay:${(i % 3) * 70}ms`}><CaseCard item={c} href="/our-portfolio" /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="head center" data-reveal>
        <h2 class="h2">Our Tech stack</h2>
        <p class="lead">{s.stackSub}</p>
      </div>
      <ul class="stack" data-reveal>
        {techStack.map((t) => (
          <li class="card"><img src={t.logo} alt={t.name} loading="lazy" /><span>{t.name}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2">{s.processTitle}</h2>
        {s.processSub && <p class="lead">{s.processSub}</p>}
      </div>
      <ol class="proc grid-4">
        {s.process.map((p, i) => (
          <li class="proc-step" data-reveal style={`transition-delay:${i * 70}ms`}>
            <span class="proc-n">{i + 1}</span>
            <h3 class="h3">{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="soft"><Faq items={s.faqs} /></div>
</Base>

<style>
  .svc { display: flex; flex-direction: column; gap: 10px; }
  .svc-n { font-size: 14px; font-weight: 680; color: var(--blue); }
  .svc p { color: var(--muted); font-size: 16px; }

  .why { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .why-sub { margin-top: 14px; }
  .why-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .why-list li { display: flex; gap: 14px; align-items: flex-start; padding: 22px; }
  .why-list p { color: var(--muted); font-size: 15px; margin-top: 4px; }
  .tick { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--blue-soft); display: grid; place-items: center; }
  .tick svg { width: 14px; height: 14px; fill: none; stroke: var(--blue); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .stack { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; max-width: 960px; }
  .stack li { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 24px 12px; }
  .stack img { height: 44px; width: auto; }
  .stack span { font-size: 14px; font-weight: 560; color: var(--muted); }

  .proc { list-style: none; margin: 0; padding: 0; position: relative; }
  .proc::before { content: ''; position: absolute; left: 22px; right: 22px; top: 22px; height: 2px; background: linear-gradient(90deg, var(--blue), #c9d8f1); }
  .proc-step { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .proc-n { width: 44px; height: 44px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 640; margin-bottom: 12px; box-shadow: 0 0 0 6px #fff; }
  .proc-step p { color: var(--muted); font-size: 16px; }

  @media (max-width: 900px) {
    .why { grid-template-columns: 1fr; }
    .stack { grid-template-columns: repeat(3, 1fr); }
    .proc::before { display: none; }
  }
  @media (max-width: 560px) { .why-list { grid-template-columns: 1fr; } }
</style>
