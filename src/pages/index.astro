---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { hero, steps, whatWeBuild, gcp, whyUs, casesSection, caseStudies, homeFaqs, faqIntro, BOOK_URL } from '../data/site';
---
<Base
  title="Synthlane | White-label engineering for agencies and cloud partners"
  description="Senior-led engineering capacity for agencies and cloud partners. We build under your brand. NDA by default. We never contact your clients."
>
  <!-- Hero -->
  <section class="section hero">
    <div class="wrap">
      <h1 class="d-hero hero-title">{hero.title}</h1>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="d-sm">{hero.sub}</p>
          <hr class="dotted-x" />
          <p class="muted">{hero.note}</p>
          <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call <Arrow /></a>
        </div>
        <div class="hero-art" aria-hidden="true"><canvas data-halftone></canvas></div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="tag">{steps.label}</span>
        <h2 class="d-2xl">{steps.title}</h2>
        <p class="body-lg muted">{steps.sub}</p>
      </div>
      <ol class="grid-3 plain">
        {steps.items.map((s, i) => (
          <li class="card step" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="step-dots" aria-hidden="true">{[0, 1, 2].map((k) => <i class={k <= i ? 'on' : ''}></i>)}</span>
            <h3 class="d-md">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- What we build -->
  <section class="section">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <h2 class="d-2xl">{whatWeBuild.title}</h2>
        <p class="body-lg muted">{whatWeBuild.sub}</p>
      </div>
      <div class="grid-4">
        {whatWeBuild.items.map((it, i) => (
          <a href={it.href} class="card build" data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="build-n">0{i + 1}</span>
            <h3 class="d-md">{it.title}</h3>
            <p>{it.body}</p>
            <span class="build-go">Detail <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Google Cloud & AI -->
  <section class="section">
    <div class="wrap grid-2 gcp">
      <div class="panel gcp-copy" data-reveal>
        <span class="tag">{gcp.label}</span>
        <h2 class="d-2xl">{gcp.title}</h2>
        <p class="body-lg muted">{gcp.sub}</p>
        <div class="gcp-items">
          {gcp.items.map((it) => (
            <div class="gcp-item">
              <h3 class="d-sm">{it.title}</h3>
              <p class="muted">{it.body}</p>
            </div>
          ))}
        </div>
        <a href={BOOK_URL} class="btn" target="_blank" rel="noopener">Book a discovery call <Arrow /></a>
      </div>
      <a href={gcp.feature.href} class="plasma" data-reveal>
        <span class="plasma-go" aria-hidden="true"><Arrow /></span>
        <h3 class="d-3xl">{gcp.feature.title}</h3>
        <p class="body-lg">{gcp.feature.body}</p>
      </a>
    </div>
  </section>

  <!-- Why Us -->
  <section class="section">
    <div class="wrap why">
      <div class="head why-head" data-reveal>
        <span class="tag">{whyUs.label}</span>
        <h2 class="d-2xl">{whyUs.title}</h2>
        <p class="body-lg muted">{whyUs.sub}</p>
      </div>
      <div class="why-cards">
        {whyUs.items.map((it, i) => (
          <div class="card-ember why-card" data-reveal style={`transition-delay:${i * 80}ms`}>
            <h3 class="d-lg">{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Work our founders have led -->
  <section class="section">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <h2 class="d-2xl">{casesSection.title}</h2>
        <p class="body-lg muted">{casesSection.sub}</p>
      </div>
      <div class="grid-3">
        {caseStudies.map((c, i) => (
          <div data-reveal style={`transition-delay:${(i % 3) * 70}ms`}><CaseCard item={c} href="/our-portfolio" /></div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
  <Faq items={homeFaqs} intro={faqIntro} />
</Base>

<style>
  .plain { list-style: none; margin: 0; padding: 0; }

  .hero { padding-top: 24px; }
  .hero-title { max-width: 21ch; font-size: clamp(52px, 7.6vw, 112px); margin-bottom: 24px; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--element-gap); }
  .hero-copy { background: var(--color-limestone); border-radius: var(--radius-cards); padding: clamp(28px, 3.5vw, 40px); display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 20px; }
  .hero-copy .dotted-x { width: 100%; }
  .hero-art { border-radius: var(--radius-cards); overflow: hidden; min-height: 420px; background: var(--color-plasma-violet); }
  .hero-art canvas { width: 100%; height: 100%; }

  .step { display: flex; flex-direction: column; gap: 14px; }
  .step-dots { display: flex; gap: 6px; margin-bottom: 18px; }
  .step-dots i { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--color-obsidian); }
  .step-dots i.on { background: var(--color-ember); box-shadow: none; }

  .build { display: flex; flex-direction: column; gap: 14px; transition: background 0.25s; min-height: 340px; }
  .build p { color: var(--ink-soft); transition: color 0.25s; }
  .build-n { font-family: var(--font-display); font-size: 26px; letter-spacing: 0.02em; color: var(--color-ember); margin-bottom: auto; transition: color 0.25s; }
  .build-go { display: inline-flex; align-items: center; gap: 6px; padding-top: 10px; border-top: var(--dotted); width: 100%; }
  .build:hover { background: var(--color-ember); }
  .build:hover p { color: var(--color-obsidian); }
  .build:hover .build-n { color: var(--color-obsidian); }

  .gcp-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .gcp-items { width: 100%; margin: 12px 0 16px; }
  .gcp-item { padding: 20px 0; border-top: var(--dotted); display: flex; flex-direction: column; gap: 6px; }
  .gcp-item:last-child { border-bottom: var(--dotted); }
  .plasma {
    position: relative;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 16px;
    border-radius: var(--radius-cards);
    padding: clamp(28px, 4vw, 48px);
    min-height: 420px;
    color: var(--color-chalk);
    background-color: var(--color-plasma-violet);
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.22) 1.7px, transparent 1.9px);
    background-size: 12px 12px;
    overflow: hidden;
  }
  .plasma::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(200deg, transparent 30%, var(--color-plasma-violet) 72%);
    pointer-events: none;
  }
  .plasma > * { position: relative; }
  .plasma .body-lg { max-width: 34ch; }
  .plasma-go { position: absolute !important; top: 28px; right: 28px; width: 56px; height: 56px; border-radius: 50%; background: var(--color-ember); color: var(--color-obsidian); display: grid; place-items: center; transition: transform 0.25s; }
  .plasma:hover .plasma-go { transform: rotate(-45deg); }

  .why { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--element-gap); align-items: stretch; }
  .why-head { margin: 0; padding: clamp(28px, 3.2vw, 40px) clamp(0px, 2vw, 24px) 0 0; }
  .why-cards { display: grid; gap: var(--element-gap); }
  .why-card { color: var(--color-obsidian); display: flex; flex-direction: column; gap: 14px; min-height: 220px; justify-content: flex-end; }

  @media (max-width: 900px) {
    .hero-grid, .why { grid-template-columns: 1fr; }
    .hero-art { order: -1; min-height: 240px; height: 240px; }
    .plasma { min-height: 320px; }
  }
</style>
