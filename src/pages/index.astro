---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { hero, steps, solutions, gcp, whyUs, caseStudies, BOOK_URL, techStack } from '../data/site';

const build = solutions.filter((s) => s.slug !== 'ai-ml-services');
const orbit = ['Agents', 'RAG', 'Vector Search', 'Managed memory', 'Document search', 'IAM design', 'Least-privilege', 'Data handling'];
const marquee = [...solutions.map((s) => s.short), 'NDA by default', 'We never contact your clients'];
---
<Base
  title="Synthlane | White-label engineering for agencies and cloud partners"
  description="Senior-led engineering capacity for agencies and cloud partners. We build under your brand. NDA by default. We never contact your clients."
>
  <!-- HERO -->
  <section class="hero" data-hero>
    <canvas class="hero-canvas" data-lanes aria-hidden="true"></canvas>
    <div class="hero-vignette" aria-hidden="true"></div>
    <div class="wrap hero-content" data-hero-content>
      <p class="eyebrow" data-hero-in>{hero.eyebrow} · Gurugram, India</p>
      <h1 class="display hero-title" data-split data-split-now>
        Senior-led engineering capacity for <em>agencies and cloud partners</em>
      </h1>
      <div class="hero-foot">
        <div class="hero-copy">
          <p class="hero-sub" data-hero-in>{hero.sub}</p>
          <p class="hero-note" data-hero-in>{hero.note}</p>
        </div>
        <div data-hero-in>
          <a href={BOOK_URL} class="btn hero-btn" target="_blank" rel="noopener" data-magnetic>
            Book a discovery call
            <span class="btn-dot"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true" data-hero-in><span></span>Scroll</div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {marquee.map((m) => (<><span>{m}</span><i>✦</i></>))}
        </div>
      ))}
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <section class="steps light section-pad">
    <div class="wrap steps-grid">
      <div class="steps-head">
        <p class="eyebrow" data-reveal>{steps.eyebrow}</p>
        <h2 class="display h2" data-split>How <em>white-label</em> works</h2>
        <p class="lede" data-reveal>{steps.sub}</p>
      </div>
      <ol class="steps-list" data-steps>
        <span class="steps-lane" aria-hidden="true"><span data-steps-fill></span></span>
        {steps.items.map((s, i) => (
          <li class="step" style={`--i:${i}`}>
            <div class="step-card">
              <span class="step-n display">{i + 1}.</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
              <div class="step-viz" aria-hidden="true">
                {i === 0 && (
                  <svg viewBox="0 0 120 120"><rect x="28" y="18" width="64" height="84" rx="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M40 40h40M40 52h40M40 64h26" stroke="currentColor" stroke-width="1.5"/><circle cx="84" cy="88" r="14" fill="var(--signal)"/><path d="M78 88l4 4 8-8" stroke="var(--ink)" stroke-width="2" fill="none"/></svg>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 120 120"><rect x="16" y="30" width="88" height="60" rx="10" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="16" y="30" width="88" height="16" rx="8" fill="var(--signal)"/><text x="22" y="42" font-family="monospace" font-size="8" fill="var(--ink)">YOUR BRAND</text><path d="M28 60l10 8-10 8M46 76h18" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                )}
                {i === 2 && (
                  <svg viewBox="0 0 120 120"><circle cx="42" cy="60" r="22" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="78" cy="60" r="22" fill="var(--signal)" fill-opacity=".9"/><text x="34" y="64" font-family="monospace" font-size="9" fill="currentColor">YOU</text><text x="66" y="64" font-family="monospace" font-size="8" fill="var(--ink)">CLIENT</text></svg>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section class="build section-pad">
    <div class="wrap">
      <div class="build-head">
        <p class="eyebrow" data-reveal>What we build</p>
        <h2 class="display h2" data-split>What we <em>build</em></h2>
        <p class="lede" data-reveal>Engineering we deliver under your brand, for your clients.</p>
      </div>
      <ul class="build-list">
        {build.map((s, i) => (
          <li data-reveal>
            <a href={`/solutions/${s.slug}`} class="build-row">
              <span class="build-n">0{i + 1}</span>
              <span class="build-name display">{s.name}</span>
              <span class="build-desc">{s.card}</span>
              <span class="build-arrow" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 14 14"><path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="stack" data-reveal>
        <span class="stack-label">Stack</span>
        {techStack.map((t) => <span class="stack-chip">{t}</span>)}
      </div>
    </div>
  </section>

  <!-- GOOGLE CLOUD & AI -->
  <section class="gcp section-pad">
    <div class="wrap gcp-grid">
      <div class="gcp-copy">
        <p class="eyebrow" data-reveal>{gcp.eyebrow}</p>
        <h2 class="display h2" data-split>Google Cloud <em>&amp; AI</em></h2>
        <p class="lede" data-reveal>{gcp.sub}</p>
        <div class="gcp-items">
          {gcp.items.map((it) => (
            <div class="gcp-item" data-reveal>
              <h3>{it.title}</h3>
              <p>{it.body}</p>
            </div>
          ))}
          <a href={gcp.feature.href} class="gcp-feature" data-reveal data-tilt>
            <span class="gcp-feature-k">Featured</span>
            <h3 class="display">{gcp.feature.title}</h3>
            <p>{gcp.feature.body}</p>
            <span class="gcp-feature-go">Explore →</span>
          </a>
        </div>
        <div data-reveal>
          <a href={BOOK_URL} class="btn btn-ghost" target="_blank" rel="noopener" data-magnetic>
            Book a discovery call<span class="btn-dot">→</span>
          </a>
        </div>
      </div>
      <div class="orbit-wrap" aria-hidden="true">
        <div class="orbit">
          <div class="orbit-ring r1"></div>
          <div class="orbit-ring r2"></div>
          <div class="orbit-ring r3"></div>
          <div class="orbit-core">
            <span class="display">Vertex AI</span>
            <small>on Google Cloud</small>
          </div>
          <div class="orbit-spin">
            {orbit.map((o, i) => (
              <span class="orbit-node" style={`--a:${(360 / orbit.length) * i}deg; --r:${i % 2 ? 40 : 47}`}>
                <span class="orbit-label">{o}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="why light section-pad">
    <div class="wrap why-grid">
      <div class="peel" data-peel aria-hidden="true">
        <div class="peel-back" data-peel-back>
          <div class="peel-back-lanes">{Array.from({ length: 7 }).map((_, i) => <span style={`--i:${i}`}></span>)}</div>
          <span class="peel-back-label"><b class="display">Built by Synthlane.</b>Engineering · under your name</span>
        </div>
        <div class="peel-front" data-peel-front>
          <div class="pf-bar"><i></i><i></i><i></i><span>youragency.com</span></div>
          <div class="pf-body">
            <span class="pf-brand">YOUR<br />BRAND<sup>®</sup></span>
            <div class="pf-lines"><b></b><b></b><b></b></div>
            <span class="pf-ship">Shipped ✓</span>
          </div>
        </div>
      </div>
      <div class="why-copy">
        <p class="eyebrow" data-reveal>{whyUs.eyebrow}</p>
        <h2 class="display h2" data-split>Built to work <em>behind your brand</em></h2>
        <p class="lede" data-reveal>{whyUs.sub}</p>
        <div class="why-items">
          {whyUs.items.map((it, i) => (
            <div class="why-item" data-reveal>
              <span class="why-icon">{i === 0 ? '§' : '◈'}</span>
              <div>
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="cases" data-hscroll>
    <div class="cases-inner">
      <div class="wrap cases-head">
        <div>
          <p class="eyebrow">Track record</p>
          <h2 class="display h2" data-split>Work our <em>founders</em> have led</h2>
        </div>
        <p class="lede">Projects led by Synthlane’s founders at previous companies, before Synthlane.</p>
      </div>
      <div class="cases-track" data-hscroll-track>
        {caseStudies.map((c, i) => <CaseCard item={c} index={i} class="cases-card" />)}
        <a href="/our-portfolio" class="cases-more">
          <span class="display">See the full portfolio</span>
          <span class="cases-more-arrow">→</span>
        </a>
      </div>
      <div class="wrap"><div class="cases-progress"><span data-hscroll-bar></span></div></div>
    </div>
  </section>

  <CtaBand />
  <Faq />
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; background: var(--ink); }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-vignette { position: absolute; inset: 0; background: radial-gradient(120% 80% at 50% 45%, transparent 40%, var(--ink) 92%), linear-gradient(180deg, transparent 55%, rgba(10,11,13,.85)); pointer-events: none; }
  .hero-content { position: relative; z-index: 2; padding-top: 140px; padding-bottom: clamp(48px, 7vw, 96px); display: grid; gap: clamp(24px, 3vw, 40px); }
  .hero-title { font-size: clamp(50px, 8.4vw, 148px); max-width: 15ch; }
  .hero-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; border-top: 1px solid var(--line-dark); padding-top: 28px; }
  .hero-copy { display: grid; gap: 10px; max-width: 46ch; }
  .hero-sub { font-size: clamp(18px, 1.6vw, 23px); line-height: 1.4; }
  .hero-note { color: var(--muted-dark); font-family: var(--mono); font-size: 13px; letter-spacing: 0.02em; }
  .hero-btn { --h: 62px; font-size: 17px; padding-left: 30px; }
  .hero-btn .btn-dot { width: 46px; height: 46px; }
  .hero-scroll { position: absolute; right: var(--gutter); top: 50%; z-index: 2; writing-mode: vertical-rl; font-family: var(--mono); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted-dark); display: flex; align-items: center; gap: 14px; }
  .hero-scroll span { width: 1px; height: 64px; background: var(--line-dark); position: relative; overflow: hidden; }
  .hero-scroll span::after { content: ''; position: absolute; left: 0; width: 1px; height: 40%; background: var(--signal); animation: drop 1.8s var(--ease) infinite; }
  @keyframes drop { from { top: -40%; } to { top: 100%; } }
  @media (max-width: 760px) { .hero-scroll { display: none; } }

  /* MARQUEE */
  .marquee { background: var(--signal); color: var(--ink); overflow: hidden; padding: 18px 0; transform: rotate(-1.2deg) scale(1.02); margin: -10px 0; position: relative; z-index: 3; }
  .marquee-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee-group { display: flex; align-items: center; gap: 28px; padding-right: 28px; }
  .marquee span { font-family: var(--serif); font-size: clamp(26px, 3vw, 42px); white-space: nowrap; }
  .marquee i { font-style: normal; font-size: 18px; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* STEPS */
  .steps-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(40px, 6vw, 110px); align-items: start; }
  .steps-head { position: sticky; top: 130px; display: grid; gap: 24px; }
  .steps-list { list-style: none; margin: 0; padding: 0 0 0 36px; position: relative; display: grid; gap: 28px; }
  .steps-lane { position: absolute; left: 6px; top: 10px; bottom: 10px; width: 2px; background: var(--line-light); border-radius: 2px; }
  .steps-lane span { position: absolute; inset: 0; background: var(--signal); transform-origin: top; border-radius: 2px; }
  .step { position: sticky; top: calc(130px + var(--i) * 26px); }
  .step::before { content: ''; position: absolute; left: -36px; top: 40px; width: 14px; height: 14px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 2px var(--signal); }
  .step-card {
    display: grid; grid-template-columns: auto 1fr; gap: 12px 28px;
    padding: clamp(26px, 3vw, 44px);
    border-radius: 28px;
    background: #fbfaf7;
    border: 1px solid var(--line-light);
    box-shadow: 0 30px 60px -40px rgba(10, 11, 13, 0.35);
    min-height: 260px;
    position: relative;
    overflow: hidden;
  }
  .step-n { font-size: clamp(64px, 7vw, 110px); line-height: 0.8; color: var(--signal); }
  .step-card h3 { font-size: clamp(24px, 2.3vw, 34px); font-weight: 520; letter-spacing: -0.02em; margin-bottom: 12px; }
  .step-card p { color: var(--muted-light); font-size: 17px; max-width: 38ch; }
  .step-card { padding-right: clamp(26px, 11vw, 160px); }
  .step-viz { position: absolute; right: 26px; top: 26px; width: 96px; color: var(--ink); opacity: 0.85; }
  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: 1fr; }
    .steps-head { position: static; }
    .step-card { grid-template-columns: 1fr; padding-right: 26px; padding-bottom: 120px; }
    .step-viz { top: auto; bottom: 18px; }
  }

  /* BUILD */
  .build { background: var(--ink); }
  .build-head { display: grid; gap: 24px; margin-bottom: clamp(48px, 6vw, 80px); max-width: 900px; }
  .build-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-dark); }
  .build-list li { border-bottom: 1px solid var(--line-dark); }
  .build-row {
    position: relative;
    display: grid; grid-template-columns: 60px 1.2fr 1fr 56px; align-items: center; gap: 24px;
    padding: clamp(26px, 3vw, 40px) 12px;
    isolation: isolate;
    overflow: hidden;
    transition: color 0.5s var(--ease);
  }
  .build-row::before { content: ''; position: absolute; inset: 0; background: var(--signal); transform: scaleY(0); transform-origin: bottom; transition: transform 0.6s var(--ease); z-index: -1; }
  .build-row:hover { color: var(--ink); }
  .build-row:hover::before { transform: scaleY(1); }
  .build-n { font-family: var(--mono); font-size: 12px; color: var(--signal); transition: color 0.5s; }
  .build-row:hover .build-n { color: var(--ink); }
  .build-name { font-size: clamp(30px, 3.8vw, 60px); transition: transform 0.6s var(--ease); }
  .build-row:hover .build-name { transform: translateX(14px); }
  .build-desc { color: var(--muted-dark); transition: color 0.5s; }
  .build-row:hover .build-desc { color: rgba(10, 11, 13, 0.75); }
  .build-arrow { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--line-dark); transition: transform 0.6s var(--ease), background 0.4s; }
  .build-row:hover .build-arrow { transform: rotate(45deg); background: var(--ink); color: var(--paper); }
  .stack { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 48px; }
  .stack-label { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted-dark); margin-right: 8px; }
  .stack-chip { padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line-dark); font-size: 14px; transition: border-color 0.3s, color 0.3s; }
  .stack-chip:hover { border-color: var(--signal); color: var(--signal); }
  @media (max-width: 860px) {
    .build-row { grid-template-columns: 36px 1fr 44px; }
    .build-desc { grid-column: 2 / 3; grid-row: 2; font-size: 15px; }
    .build-arrow { width: 44px; height: 44px; grid-row: 1 / span 2; grid-column: 3; }
  }

  /* GCP */
  .gcp { background: var(--ink-2); overflow: hidden; }
  .gcp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 100px); align-items: center; }
  .gcp-copy { display: grid; gap: 26px; }
  .gcp-items { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 8px 0 10px; }
  .gcp-item { padding: 24px; border-radius: 20px; border: 1px solid var(--line-dark); background: rgba(239, 236, 230, 0.02); }
  .gcp-item h3 { font-size: 19px; font-weight: 560; margin-bottom: 8px; }
  .gcp-item p { color: var(--muted-dark); font-size: 15px; }
  .gcp-feature {
    grid-column: 1 / -1;
    display: grid; gap: 8px;
    padding: 28px;
    border-radius: 24px;
    background: linear-gradient(135deg, var(--signal), #ff8a4c 60%, #ffb08a);
    color: var(--ink);
    position: relative; overflow: hidden;
  }
  .gcp-feature-k { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; }
  .gcp-feature h3 { font-size: 46px; }
  .gcp-feature p { max-width: 40ch; }
  .gcp-feature-go { position: absolute; right: 26px; top: 26px; font-weight: 600; }
  .orbit-wrap { display: grid; place-items: center; }
  .orbit { position: relative; width: min(560px, 100%); aspect-ratio: 1; }
  .orbit-ring { position: absolute; border-radius: 50%; border: 1px dashed rgba(239, 236, 230, 0.14); inset: 0; }
  .orbit-ring.r2 { inset: 9%; border-style: solid; border-color: rgba(239, 236, 230, 0.07); }
  .orbit-ring.r3 { inset: 26%; border-color: rgba(255, 90, 31, 0.35); animation: pulse 3.6s ease-in-out infinite; }
  @keyframes pulse { 50% { transform: scale(1.05); border-color: rgba(255, 90, 31, 0.7); } }
  .orbit-core { position: absolute; inset: 32%; border-radius: 50%; display: grid; place-content: center; text-align: center; background: radial-gradient(circle at 35% 30%, #2a2d34, var(--ink) 70%); box-shadow: 0 0 80px rgba(255, 90, 31, 0.3), inset 0 0 0 1px var(--line-dark); }
  .orbit-core .display { font-size: clamp(28px, 3vw, 44px); }
  .orbit-core small { font-family: var(--mono); font-size: 11px; color: var(--muted-dark); letter-spacing: 0.1em; text-transform: uppercase; }
  .orbit-spin { position: absolute; inset: 0; animation: spin 60s linear infinite; }
  .orbit-node { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform: rotate(var(--a)) translateY(calc(var(--r) * -5.4px)); }
  @supports (width: 1cqw) {
    .orbit { container-type: inline-size; }
    .orbit-node { transform: rotate(var(--a)) translateY(calc(var(--r) * -1cqw)); }
  }
  .orbit-label {
    position: absolute; left: 0; top: 0;
    transform: translate(-50%, -50%) rotate(calc(var(--a) * -1));
    white-space: nowrap;
    padding: 8px 14px; border-radius: 999px;
    background: var(--ink-3); border: 1px solid var(--line-dark);
    font-family: var(--mono); font-size: 12px;
    animation: counter 60s linear infinite;
  }
  .orbit-node:nth-child(3n) .orbit-label { border-color: rgba(255, 90, 31, 0.5); color: var(--signal-soft); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes counter { from { rotate: 0deg; } to { rotate: -360deg; } }
  @media (max-width: 960px) {
    .gcp-grid { grid-template-columns: 1fr; }
    .orbit-wrap { order: -1; }
    .orbit { width: min(560px, 84%); }
    .orbit-label { font-size: 10px; padding: 6px 10px; }
  }
  @media (max-width: 560px) { .gcp-items { grid-template-columns: 1fr; } }

  /* WHY */
  .why { overflow: hidden; }
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 120px); align-items: center; }
  .why-copy { display: grid; gap: 26px; }
  .why-items { display: grid; gap: 14px; margin-top: 10px; }
  .why-item { display: grid; grid-template-columns: 52px 1fr; gap: 18px; padding: 24px 0; border-top: 1px solid var(--line-light); }
  .why-icon { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--ink); color: var(--signal); font-size: 22px; }
  .why-item h3 { font-size: 22px; font-weight: 560; margin-bottom: 6px; }
  .why-item p { color: var(--muted-light); }
  .peel { position: relative; aspect-ratio: 4 / 4.4; max-width: 520px; width: 100%; justify-self: center; perspective: 1000px; }
  .peel-back, .peel-front { position: absolute; inset: 6% 4% 4% 8%; border-radius: 28px; }
  .peel-back { background: var(--ink); overflow: hidden; transform: translate(14px, 14px); }
  .peel-back-lanes { position: absolute; inset: 0; display: flex; justify-content: space-around; transform: perspective(400px) rotateX(55deg) scale(1.6); transform-origin: bottom; }
  .peel-back-lanes span { width: 1px; background: rgba(239, 236, 230, 0.15); position: relative; overflow: hidden; }
  .peel-back-lanes span::after { content: ''; position: absolute; left: -1px; width: 3px; height: 30%; background: linear-gradient(transparent, var(--signal)); animation: lane calc(1.6s + var(--i) * 0.3s) linear infinite; animation-delay: calc(var(--i) * -0.4s); }
  @keyframes lane { from { top: -30%; } to { top: 100%; } }
  .peel-back-label { position: absolute; right: 26px; bottom: 24px; text-align: right; display: grid; gap: 6px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); }
  .peel-back-label b { font-weight: 400; font-size: clamp(30px, 3vw, 44px); letter-spacing: -0.02em; text-transform: none; color: var(--paper); }
