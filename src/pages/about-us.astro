---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { about, aboutFaqs, faqIntro } from '../data/site';
---
<Base
  title="About Synthlane | White-label engineering partner"
  description="Synthlane Technologies was founded in Gurugram, India, by a former Meta engineer. Senior-led engineering for agencies and cloud partners, delivered under their brand."
>
  <PageHero title={about.title} intro={about.body} crumbs={[{ label: 'About Us' }]} />

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><h2 class="h2">{about.mvTitle}</h2></div>
      <div class="grid-2">
        <article class="card mv" data-reveal>
          <span class="label">Mission</span>
          <p class="mv-text">{about.mission}</p>
        </article>
        <article class="card mv" data-reveal style="transition-delay:80ms">
          <span class="label">Vision</span>
          <p class="mv-text">{about.vision}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="head" data-reveal><h2 class="h2">{about.valuesTitle}</h2></div>
      <div class="grid-3">
        {about.values.map((v, i) => (
          <article class="card value" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="value-n">0{i + 1}</span>
            <h3 class="h3">{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-in" data-reveal>
      <p class="band-title">{about.band}</p>
      <p class="band-sub">{about.bandSub}</p>
    </div>
  </section>

  <Faq items={aboutFaqs} intro={faqIntro} />
</Base>

<style>
  .mv { display: flex; flex-direction: column; gap: 12px; padding: clamp(28px, 3.5vw, 44px); border-top: 3px solid var(--blue); }
  .mv-text { font-size: clamp(21px, 2vw, 26px); line-height: 1.4; font-weight: 520; letter-spacing: -0.01em; color: var(--navy); }
  .value { display: flex; flex-direction: column; gap: 10px; }
  .value-n { font-size: 15px; font-weight: 680; color: var(--blue); }
  .value p { color: var(--muted); }
  .band { background: var(--navy); color: #fff; }
  .band-in { padding-top: clamp(48px, 6vw, 72px); padding-bottom: clamp(48px, 6vw, 72px); display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; }
  .band-title { font-size: clamp(26px, 3.2vw, 40px); font-weight: 620; letter-spacing: -0.02em; }
  .band-sub { font-size: clamp(18px, 1.6vw, 22px); color: #b9cdee; font-weight: 520; }
</style>
