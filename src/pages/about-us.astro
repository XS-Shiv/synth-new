---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { about, aboutFaqs, faqIntro } from '../data/site';
---
<Base
  title="About Synthlane | White-label engineering partner"
  description="Synthlane Technologies was founded in Gurugram, India, by a former Meta engineer. Senior-led engineering for agencies and cloud partners, delivered under their brand."
>
  <PageHero title={about.title} intro={about.body} crumbs={[{ label: 'About Us' }]} />

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><h2 class="d-2xl">{about.mvTitle}</h2></div>
      <div class="grid-2">
        <article class="card mv" data-reveal>
          <span class="tag">Mission</span>
          <p class="d-lg">{about.mission}</p>
        </article>
        <article class="card-ember mv mv-ember" data-reveal style="transition-delay:80ms">
          <span class="tag">Vision</span>
          <p class="d-lg">{about.vision}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal><h2 class="d-2xl">{about.valuesTitle}</h2></div>
      <div class="grid-3">
        {about.values.map((v, i) => (
          <article class="card value" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="value-n">0{i + 1}</span>
            <h3 class="d-md">{v.title}</h3>
            <p class="muted">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="band" data-reveal>
        <p class="d-3xl">{about.band}</p>
        <p class="d-lg band-sub">{about.bandSub}</p>
      </div>
    </div>
  </section>

  <Faq items={aboutFaqs} intro={faqIntro} />
</Base>

<style>
  .mv { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 48px; min-height: 320px; }
  .mv-ember { color: var(--color-obsidian); }
  .value { display: flex; flex-direction: column; gap: 14px; min-height: 280px; }
  .value-n { font-family: var(--font-display); font-size: 80px; line-height: 1; letter-spacing: 0.02em; color: var(--color-ember); margin-bottom: auto; }
  .band {
    position: relative; overflow: hidden;
    border-radius: var(--radius-cards);
    padding: clamp(32px, 5vw, 64px);
    background-color: var(--color-limestone);
    display: flex; flex-direction: column; gap: 16px;
  }
  .band::after {
    content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 45%;
    background-image: radial-gradient(circle, var(--color-ember) 2.6px, transparent 2.8px);
    background-size: 13px 13px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 85%);
    mask-image: linear-gradient(90deg, transparent, #000 85%);
    pointer-events: none;
  }
  .band > * { position: relative; max-width: 16ch; }
  .band-sub { color: var(--color-ember); }
</style>
