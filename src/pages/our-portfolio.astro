---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseCard from '../components/CaseCard.astro';
import { portfolio } from '../data/site';
---
<Base
  title="Our Portfolio | Synthlane"
  description="Work our founders have led — projects led by Synthlane's founders at previous companies, before Synthlane."
>
  <PageHero title={portfolio.title} crumbs={[{ label: 'Our Portfolio' }]} />

  <section class="section">
    <div class="wrap grid-2">
      {portfolio.featured.map((c, i) => (
        <div data-reveal style={`transition-delay:${i * 80}ms`}><CaseCard item={c} large /></div>
      ))}
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 class="h2">{portfolio.projectsTitle}</h2>
        <p class="lead">{portfolio.projectsSub}</p>
      </div>
      <div class="grid-3">
        {portfolio.projects.map((c, i) => (
          <div data-reveal style={`transition-delay:${(i % 3) * 70}ms`}><CaseCard item={c} /></div>
        ))}
      </div>
    </div>
  </section>
</Base>
